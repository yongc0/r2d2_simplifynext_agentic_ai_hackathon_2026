# ---- secrets. Never commit these. -------------------------------------
# Vite inlines anything named VITE_* into the BUILT BUNDLE, in clear text.
# A key in one of these files is a key published to every visitor, so these
# are ignored even though nothing in the client needs a key today.
.env
.env.local
.env.*.local

# ---- dependencies and build output ------------------------------------
# Both are reproducible from package-lock.json: `npm ci && npm run build`.
# node_modules is ~200MB and would dominate the repository.
node_modules/
dist/

# ---- caches and logs ---------------------------------------------------
.vite/
coverage/
*.log
.DS_Store

# TypeScript incremental build state. Machine-specific, regenerated by
# `tsc -b`, and pure churn in a diff.
*.tsbuildinfo
