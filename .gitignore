# ---- secrets. Never commit these. -------------------------------------
# _common.py reads lab/.env on import: Groq key, AWS profile, region.
.env
lab/.env
*.pem
credentials

# ---- environments and caches ------------------------------------------
lab/.venv/
.venv/
__pycache__/
*.pyc
.DS_Store

# ---- generated lab output ---------------------------------------------
# Regenerated by make_sample_pdf.py
# lab/sample_docs/*.pdf
# deepagents writes its filesystem backend here
lab/section_5_deepagents/workspace/
lab/section_5_deepagents/workspace_subagents/
lab/workspace/

# ---- AgentCore: local deployment state and build artefacts ------------
# .bedrock_agentcore.yaml holds YOUR account's ARNs and role names, and is
# written by `configure` — each person generates their own.
lab/section_6_agentcore/agent/.bedrock_agentcore.yaml
lab/section_6_agentcore/agent/Dockerfile
lab/section_6_agentcore/agent/.dockerignore
# The dependency bundle the toolkit builds before uploading: ~42MB, rebuilt on
# every deploy, and over GitHub's comfortable file size. Never commit it.
lab/section_6_agentcore/agent/dependencies.zip
lab/section_6_agentcore/agent/dependencies.hash

# ---- the deck ----------------------------------------------------------
# Remove this line if you want the .pptx tracked in the repo.
*.pptx
~$*
*_solution.py

# A stray local file: `lab/env` (no dot) holds a GROQ_MODEL setting and nothing
# else. The lab reads `lab/.env`, so this one is a typo somebody made locally.
# Ignored rather than deleted — it is not ours to remove from a working tree —
# and deliberately NOT staged, because a file named like a dotenv is the last
# place a credential should be able to arrive unnoticed.
lab/env

# Local Netlify folder
.netlify
